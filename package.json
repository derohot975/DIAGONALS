{
  "name": "diagonale-wine-app",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx --env-file=.env server/index.ts",
    "dev:5001": "PORT=5001 NODE_ENV=development tsx --env-file=.env server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "preview": "vite preview --port 4173 --host",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "guard:lens": "npm run guard:lens:props && npm run guard:lens:zindex",
    "guard:lens:props": "! grep -r --include='*.tsx' --include='*.ts' -E '(isOpen=|visible=)' client/src/components/search client/src/components/ui || (echo 'ERROR: Usa SOLO open (boolean) come prop di visibilità' && exit 1)",
    "guard:lens:zindex": "! grep -r --include='*.tsx' --include='*.ts' -E 'z-\\[[0-9]+\\]' client/src/components/search client/src/components/ui || (echo 'ERROR: Usa SOLO z-index tokens da styles/tokens/zIndex.ts' && exit 1)",
    "db:push": "drizzle-kit push",
    "backup": "node scripts/backup-system.js create",
    "backup:list": "node scripts/backup-system.js list",
    "backup:restore": "node scripts/backup-system.js restore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "quality:deadcode": "knip",
    "security:audit": "npm audit --audit-level=high",
    "test:all": "npm run check && npm run lint && npm run build && npm run guard:lens && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.19",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "knip": "^5.88.1",
    "postcss": "^8.4.47",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.59.1",
    "unplugin-icons": "^22.3.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "canvas": "^3.2.3"
  }
}
